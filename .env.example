# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/cloudledger

# Cloudly AI Assistant (required for chat)
ANTHROPIC_API_KEY=

# GitHub CI/CD Integration (optional)
GITHUB_TOKEN=
GITHUB_REPO=

# Snowflake Data Warehouse (optional)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# General
DBT_PROFILE_DIR=./dbt_project
ENVIRONMENT=development
